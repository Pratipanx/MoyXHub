local lootStatus=label(battle,"เก็บของ: ปิด",11,{Size=UDim2.new(1,0,0,30),TextWrapped=true},"Muted")
local stageStatus=label(battle,"ฟาร์มด่าน: ปิด",11,{Size=UDim2.new(1,0,0,30),TextWrapped=true},"Muted")
local lootBusy=false
local lootMoving=false
local function stopLootMove()
    if not lootMoving then return end
    lootMoving=false
    local c=P.Character
    local h=c and c:FindFirstChildOfClass("Humanoid")
    local r=c and c:FindFirstChild("HumanoidRootPart")
    if h and r then h:MoveTo(r.Position) end
end
local function hud()
    local f=P.PlayerGui:FindFirstChild("FusionUI")
    return f and f:FindFirstChild("Hud")
end
local function bagFull()
    local ui=hud()
    local left=ui and ui:FindFirstChild("BottomLeft")
    local item=left and left:FindFirstChild("Stat_Seeds")
    local content=item and item:FindFirstChild("Content")
    local value=content and content:FindFirstChild("Value")
    if not value then return false end
    local a,b=string.match(value.Text,"(%d+)%s*/%s*(%d+)")
    return a~=nil and b~=nil and tonumber(a)>=tonumber(b)
end
local function canRun()
    if window.Visible then return false,"ซ่อนเมนูเพื่อเริ่ม" end
    if not isrbxactive() then return false,"พัก: Roblox ไม่ได้ Focus" end
    if UIS:GetFocusedTextBox() then return false,"พัก: กำลังพิมพ์" end
    if UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.D) then lootMoving=false;return false,"พัก: ควบคุมเอง" end
    return true,""
end
local function lootStep()
    if bagFull() then lootStatus.Text="กระเป๋าเต็ม";return false end
    local c=P.Character
    local h=c and c:FindFirstChildOfClass("Humanoid")
    local root=c and c:FindFirstChild("HumanoidRootPart")
    local drops=workspace:FindFirstChild("_SeedDrops")
    if not h or not root or h.Health<=0 or not drops then lootStatus.Text="รอของดรอปในพื้นที่";return false end
    local nearest,prompt=nil,nil
    local best=state["fruit.loot.range"] or 25
    for _,m in ipairs(drops:GetChildren()) do
        local b=m:FindFirstChild("Body")
        if b and b:IsA("BasePart") then
            local q=b:FindFirstChildWhichIsA("ProximityPrompt",true) or m:FindFirstChildWhichIsA("ProximityPrompt",true)
            local d=(b.Position-root.Position).Magnitude
            if q and q.Enabled and q.ActionText=="Collect" and q.KeyboardKeyCode==Enum.KeyCode.E and q.HoldDuration==0 and d<best then nearest,prompt,best=b,q,d end
        end
    end
    if not nearest or not prompt then lootStatus.Text="รอของดรอปใกล้ตัว";return false end
    if best<=math.min(3,prompt.MaxActivationDistance) then
        stopLootMove()
        lootStatus.Text="กำลังเก็บ: "..prompt.ObjectText
        if not state["fruit.loot.auto"] or not gui.Parent or not isrbxactive() then return false end
        local ok,err=pcall(function() keypress(0x45);task.wait(.06) end)
        pcall(keyrelease,0x45)
        if not ok then error(err) end
        task.wait(.7)
    else
        lootMoving=true;h:MoveTo(nearest.Position)
        lootStatus.Text="เดินไปเก็บ: "..prompt.ObjectText
    end
    return true
end
-- Normal movement only; never change gates, collisions, or server calls.
local function gatePart(folder,prefix,n)
    local m=folder:FindFirstChild(prefix..n)
    local b=m and m:FindFirstChild("SurfaceGuiPart")
    return b and b:IsA("BasePart") and b or nil
end
local function flat(v) return Vector3.new(v.X,0,v.Z) end
local function getStage(folder,pos)
    local found=nil
    for n=1,24 do
        local entry=gatePart(folder,"Reco_",n)
        local exit=gatePart(folder,"Defeat_",n)
        if entry and exit then
            local axis=flat(exit.Position-entry.Position)
            local length=axis.Magnitude
            if length>1 then
                local dir=axis.Unit
                local rel=flat(pos-entry.Position)
                local along=rel:Dot(dir)
                local lateral=(rel-dir*along).Magnitude
                if along>=-1 and along<=length+28 and lateral<=entry.Size.X*.5+10 then
                    found={n=n,entry=entry,exit=exit,dir=dir,length=length,along=along}
                end
            end
        end
    end
    return found
end
local function stageStep()
    local c=P.Character
    local h=c and c:FindFirstChildOfClass("Humanoid")
    local root=c and c:FindFirstChild("HumanoidRootPart")
    local f=workspace:FindFirstChild("_LocalGates")
    if not h or not root or h.Health<=0 or not f then stopLootMove();stageStatus.Text="รอตัวละครและพื้นที่ด่าน";return end
    local ui=hud()
    local bottom=ui and ui:FindFirstChild("BottomCentre")
    local actions=bottom and bottom:FindFirstChild("Actions")
    local auto=actions and actions:FindFirstChild("AutoClicker")
    local host=auto and auto:FindFirstChild("_FeelHost")
    local btn=host and host:FindFirstChild("AutoClickBtn")
    local badge=btn and btn:FindFirstChild("Badge")
    if not badge or badge.Text~="ON" then stopLootMove();stageStatus.Text="เปิด Auto ของเกมก่อน";return end
    local stage=getStage(f,root.Position)
    if not stage then stopLootMove();stageStatus.Text="เดินเข้าด่านก่อน";return end
    local target
    if stage.exit.CanCollide then
        target=stage.entry.Position+stage.dir*(stage.length*.76)
        stageStatus.Text="Stage "..stage.n.." • รอการต่อสู้"
    else
        local nextEntry=gatePart(f,"Reco_",stage.n+1)
        local nextExit=gatePart(f,"Defeat_",stage.n+1)
        if not nextEntry or not nextExit then stopLootMove();stageStatus.Text="Stage "..stage.n.." • ไม่มีทางต่อที่ตรวจพบ";return end
        if nextEntry.CanCollide then stopLootMove();stageStatus.Text="Stage "..stage.n.." • รอประตูถัดไป";return end
        target=nextEntry.Position+stage.dir*14
        stageStatus.Text="Stage "..stage.n.." → "..(stage.n+1)
    end
    target=Vector3.new(target.X,root.Position.Y,target.Z)
    if flat(target-root.Position).Magnitude>3 then lootMoving=true;h:MoveTo(target) else stopLootMove() end
end
local function refreshAutomation()
    if not state["fruit.loot.auto"] then lootStatus.Text="เก็บของ: ปิด" end
    if not state["fruit.stage.auto"] then stageStatus.Text="ฟาร์มด่าน: ปิด" end
    if not state["fruit.loot.auto"] and not state["fruit.stage.auto"] then stopLootMove();return end
    if lootBusy then return end
    lootBusy=true
    task.spawn(function()
        while gui.Parent and (state["fruit.loot.auto"] or state["fruit.stage.auto"]) do
            local ok,err=pcall(function()
                local ready,reason=canRun()
                if not ready then
                    stopLootMove()
                    if state["fruit.loot.auto"] then lootStatus.Text=reason end
                    if state["fruit.stage.auto"] then stageStatus.Text=reason end
                    return
                end
                local collected=false
                if state["fruit.loot.auto"] then collected=lootStep() end
                if state["fruit.stage.auto"] then
                    if collected then stageStatus.Text="รอเก็บของก่อนเดินต่อ" else stageStep() end
                elseif not collected then stopLootMove() end
            end)
            if not ok then stopLootMove();stageStatus.Text="ผิดพลาด: "..tostring(err);lootStatus.Text="พักระบบ" end
            task.wait(.5)
        end
        stopLootMove();lootBusy=false
    end)
end
controller:SetCallback("fruit.loot.auto",refreshAutomation)
controller:SetCallback("fruit.stage.auto",refreshAutomation)
gui.Destroying:Connect(function() state["fruit.loot.auto"]=false;state["fruit.stage.auto"]=false;stopLootMove() end)

