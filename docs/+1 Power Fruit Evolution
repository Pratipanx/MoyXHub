-- Decline only the exact free No button in the game's revive dialog.
local function reviveNoButton()
    local fusion=P.PlayerGui:FindFirstChild("FusionUI")
    local panel=fusion and fusion:FindFirstChild("RevivePanelRoot")
    local canvas=panel and panel:FindFirstChild("Canvas")
    local main=canvas and canvas:FindFirstChild("MainFrame")
    local actions=main and main:FindFirstChild("Actions")
    local tile=actions and actions:FindFirstChild("NoTile")
    local slab=tile and tile:FindFirstChild("Slab")
    local btn=slab and slab:FindFirstChild("No")
    local caption=btn and btn:FindFirstChild("Title")
    local title=main and main:FindFirstChild("Title")
    if not(btn and btn:IsA("TextButton") and btn.Active and caption and caption:IsA("TextLabel") and caption.Text=="No" and title and title:IsA("TextLabel") and title.Text=="REVIVE?") then return nil end
    local node=btn
    while node and node~=P.PlayerGui do
        if node:IsA("GuiObject") and not node.Visible then return nil end
        if node:IsA("ScreenGui") and not node.Enabled then return nil end
        node=node.Parent
    end
    return btn
end
local reviveLast=0
local function declineRevive()
    if not state["fruit.revive.no"] or not isrbxactive() or UIS:GetFocusedTextBox() then return end
    local btn=reviveNoButton()
    if not btn or os.clock()-reviveLast<.6 then return end
    local wasVisible=window.Visible
    if wasVisible then visible(false) end
    local ok,err=pcall(function()
        local inset=game:GetService("GuiService"):GetGuiInset()
        local centre=btn.AbsolutePosition+btn.AbsoluteSize/2
        local target=centre+inset
        mousemoveabs(math.round(target.X),math.round(target.Y))
        task.wait(.05)
        if not gui.Parent or not state["fruit.revive.no"] or not isrbxactive() or reviveNoButton()~=btn then return end
        -- Verify the actual cursor AND the topmost hit before clicking.
        local cursor=UIS:GetMouseLocation()-inset
        local pos,size=btn.AbsolutePosition,btn.AbsoluteSize
        if cursor.X<pos.X+5 or cursor.X>pos.X+size.X-5 or cursor.Y<pos.Y+5 or cursor.Y>pos.Y+size.Y-5 then return end
        local hits=P.PlayerGui:GetGuiObjectsAtPosition(math.floor(cursor.X),math.floor(cursor.Y))
        local top=hits[1]
        if not top or (top~=btn and not top:IsDescendantOf(btn)) then return end
        reviveLast=os.clock()
        mouse1click()
    end)
    if wasVisible and gui.Parent then visible(true) end
    if not ok then warn("[Moy Auto No] "..tostring(err)) end
end
task.spawn(function()
    while gui.Parent do
        local ok,err=pcall(declineRevive)
        if not ok then warn("[Moy Auto No] "..tostring(err)) end
        task.wait(.1)
    end
end)

