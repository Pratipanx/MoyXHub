local function allowedSeed(itemName,caption,rarity)
    if not itemName:match("^Seed_%d+$") then return false end
    local clean=caption:gsub("<[^>]+>",""):gsub("%s+[xX]%d+%s*$",""):match("^%s*(.-)%s*$")
    local grade=rarity:gsub("<[^>]+>",""):match("^%s*(.-)%s*$"):upper()
    if grade=="SEED" then return state["fruit.sell.seed."..clean]==true end
    local group=rarityGroups[grade]
    return group~=nil and state["fruit.sell.grade."..group]==true
end
local function sellButton()
    local fusion=P.PlayerGui:FindFirstChild("FusionUI")
    local panel=fusion and fusion:FindFirstChild("SellRoot")
    local canvas=panel and panel:FindFirstChild("Canvas")
    local main=canvas and canvas:FindFirstChild("MainFrame")
    local content=main and main:FindFirstChild("Content")
    local list=content and content:FindFirstChild("List")
    if not sellVisible(panel) then return nil,"เปิดร้าน SELL ก่อน" end
    if not list then return nil,"ไม่พบรายการขาย" end
    local selected=0
    for _,item in ipairs(list:GetChildren()) do
        if item:IsA("GuiObject") and item.Visible then
            local rarity=item:FindFirstChild("Rarity")
            local caption=item:FindFirstChild("Name")
            local one=item:FindFirstChild("SellOne")
            if rarity and rarity:IsA("TextLabel") and caption and caption:IsA("TextLabel") and allowedSeed(item.Name,caption.Text,rarity.Text) then
                selected+=1
                if one and one:IsA("TextButton") and one.Active and sellVisible(one) then
                    -- Sell one selected item at a time. Never use Sell All.
                    local price=one:FindFirstChild("Amount",true)
                    if price and price:IsA("TextLabel") and tonumber(price.Text) and tonumber(price.Text)>0 then
                        return one,caption.Text:gsub("<[^>]+>","").." • "..price.Text.." Gold"
                    end
                end
            end
        end
    end
    return nil,if selected>0 then "ไม่พบปุ่มขายรายการที่เลือก" else "ไม่มีเมล็ดที่เลือกให้ขาย"
